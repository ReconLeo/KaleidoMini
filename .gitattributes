# 全仓强制 LF，避免 Windows 下 CRLF 污染（插件字段校验与 locale/JSON 读取均按 LF 校验）
* text=auto eol=lf

# 二进制/大文件不做文本归一化
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.webm binary
*.flv binary
*.zip binary
*.kqb binary
*.heapsnapshot binary

# 明确文本类型
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
